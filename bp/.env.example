# Copy this file to .env in this same folder (bp/):
#   cp .env.example .env
# Then fill in values. Never commit .env.

# Required for runserver. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# true for local development; false in production
DEBUG=True

# Comma-separated hostnames (no spaces)
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# Comma-separated origins that may POST (must include scheme)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Comma-separated origins for the Flutter / mobile API. Leave empty locally.
CORS_ALLOWED_ORIGINS=

# Gmail (or other SMTP) for password-reset email. Leave empty to skip mail locally.
EMAIL_USER=
EMAIL_PASS=

# Google OAuth (django-allauth). Leave empty if you are not using Google login locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production (Render). Locally leave empty to keep SQLite.
# Neon example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
